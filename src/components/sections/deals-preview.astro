---
const deals = [
  {
    rank: 1,
    address: "1040 S Miami Ave, Brickell",
    county: "Miami-Dade",
    landValue: "$12.5M",
    zoning: "T6-80",
    sqft: "43,560",
    lastSale: "Mar 2019",
    waterfront: 87,
    zoneScore: 100,
    priceScore: 94,
    total: 88.6,
    tier: "A",
  },
  {
    rank: 2,
    address: "601 NE 36th St, Edgewater",
    county: "Miami-Dade",
    landValue: "$28.2M",
    zoning: "T6-60",
    sqft: "67,800",
    lastSale: "Jun 2016",
    waterfront: 92,
    zoneScore: 90,
    priceScore: 86,
    total: 84.1,
    tier: "A",
  },
  {
    rank: 3,
    address: "1700 N Bayshore Dr",
    county: "Miami-Dade",
    landValue: "$41.0M",
    zoning: "MXD",
    sqft: "52,200",
    lastSale: "Nov 2015",
    waterfront: 78,
    zoneScore: 85,
    priceScore: 98,
    total: 79.3,
    tier: "A",
  },
];
---

<section id="markets" class="max-w-7xl mx-auto px-6 py-28">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full bg-white/5 border border-white/8 px-3 py-1.5 text-xs text-white/50 mb-4 tracking-wide uppercase">
        Live deal feed
      </div>
      <h2 class="text-4xl font-serif font-normal text-white">
        Top Tier A deals — Miami-Dade
      </h2>
    </div>
    <a href="#access" class="shrink-0 inline-flex items-center gap-2 text-sm text-white/50 hover:text-white border border-white/10 hover:border-white/20 rounded-full px-5 py-2.5 transition-all">
      Access full dashboard
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M7 7h10v10M7 17 17 7"/>
      </svg>
    </a>
  </div>

  <!-- Table header (desktop) -->
  <div class="hidden lg:grid grid-cols-[2fr_1fr_1fr_1fr_1fr_120px] gap-4 px-5 pb-3 text-xs text-white/25 uppercase tracking-wider border-b border-white/6">
    <span>Address</span>
    <span>Land value</span>
    <span>Zoning</span>
    <span>Lot size</span>
    <span>Last sale</span>
    <span class="text-right">Score</span>
  </div>

  <!-- Deals -->
  <div class="space-y-2 mt-2">
    {deals.map((deal) => (
      <div class="group glass rounded-2xl px-5 py-5 hover:border-white/12 transition-all duration-200 cursor-pointer">
        <div class="hidden lg:grid grid-cols-[2fr_1fr_1fr_1fr_1fr_120px] gap-4 items-center">
          <!-- Address -->
          <div class="flex items-center gap-3 min-w-0">
            <span class="text-xs text-white/20 tabular-nums w-4 shrink-0">#{deal.rank}</span>
            <div class="min-w-0">
              <p class="text-sm text-white font-medium truncate">{deal.address}</p>
              <p class="text-xs text-white/30 mt-0.5">{deal.county}</p>
            </div>
          </div>
          <!-- Land value -->
          <span class="text-sm text-white font-medium">{deal.landValue}</span>
          <!-- Zoning -->
          <span class="text-xs text-blue-400 border border-blue-500/20 rounded-full px-2 py-0.5 w-fit">{deal.zoning}</span>
          <!-- Sqft -->
          <span class="text-sm text-white/50">{deal.sqft} sf</span>
          <!-- Last sale -->
          <span class="text-sm text-white/30">{deal.lastSale}</span>
          <!-- Score -->
          <div class="flex items-center justify-end gap-2">
            <div class="flex-1 h-1 rounded-full bg-white/5 overflow-hidden">
              <div class="h-full rounded-full bg-blue-500" style={`width: ${deal.total}%`} />
            </div>
            <span class="text-sm font-semibold text-white tabular-nums w-10 text-right">{deal.total}</span>
            <span class={`text-xs font-medium rounded-full px-2 py-0.5 ${deal.tier === 'A' ? 'tier-a' : deal.tier === 'B' ? 'tier-b' : 'tier-c'}`}>
              {deal.tier}
            </span>
          </div>
        </div>

        <!-- Mobile layout -->
        <div class="lg:hidden">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <p class="text-sm text-white font-medium">{deal.address}</p>
              <p class="text-xs text-white/30 mt-0.5">{deal.county} · {deal.zoning}</p>
            </div>
            <span class={`shrink-0 text-xs font-medium rounded-full px-2.5 py-1 ${deal.tier === 'A' ? 'tier-a' : deal.tier === 'B' ? 'tier-b' : 'tier-c'}`}>
              {deal.total} · {deal.tier}
            </span>
          </div>
          <div class="flex gap-4 text-xs text-white/40">
            <span>{deal.landValue}</span>
            <span>{deal.sqft} sf</span>
            <span>Sold {deal.lastSale}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Blur overlay — request access to see more -->
  <div class="relative mt-2">
    <div class="glass rounded-2xl px-5 py-5 opacity-30 select-none pointer-events-none blur-sm">
      <div class="hidden lg:grid grid-cols-[2fr_1fr_1fr_1fr_1fr_120px] gap-4 items-center">
        <div class="h-4 bg-white/10 rounded w-3/4" />
        <div class="h-4 bg-white/10 rounded w-1/2" />
        <div class="h-4 bg-white/10 rounded w-1/3" />
        <div class="h-4 bg-white/10 rounded w-1/2" />
        <div class="h-4 bg-white/10 rounded w-2/3" />
        <div class="h-4 bg-white/10 rounded w-full" />
      </div>
    </div>
    <div class="absolute inset-0 flex items-center justify-center">
      <a href="#access" class="inline-flex items-center gap-2 bg-blue-500 hover:bg-blue-600 text-white px-5 py-2.5 rounded-full text-sm font-medium transition-colors shadow-lg shadow-blue-500/25">
        Request access to see all deals
      </a>
    </div>
  </div>
</section>
