---
// Miami waterfront map section
---

<section class="relative py-16 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="relative rounded-3xl overflow-hidden" style="height: 480px;">

      <!-- Map placeholder image — Miami aerial -->
      <img
        src="https://picsum.photos/seed/miamimap2/1400/480"
        alt="Miami map visualization"
        class="absolute inset-0 w-full h-full object-cover opacity-40"
      />

      <!-- Dark map overlay with grid -->
      <div class="absolute inset-0 bg-[#0a0d18]" style="opacity: 0.65;" />
      <div class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(rgba(59,130,246,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,0.4) 1px, transparent 1px); background-size: 60px 60px;" />

      <!-- Glow orbs simulating hotspots -->
      <div class="absolute" style="top: 35%; left: 48%; transform: translate(-50%, -50%);">
        <div class="relative">
          <div class="w-5 h-5 rounded-full bg-green-400 shadow-lg shadow-green-400/50 border-2 border-white/20" />
          <div class="absolute inset-0 rounded-full bg-green-400/30 animate-ping" />
          <!-- Tooltip -->
          <div class="absolute left-7 top-1/2 -translate-y-1/2 bg-[#0f1117] border border-white/10 rounded-xl px-4 py-3 whitespace-nowrap shadow-xl">
            <div class="flex items-center gap-2 mb-1">
              <span class="tier-a text-xs rounded-full px-2 py-0.5 font-medium">Tier A</span>
              <span class="text-white text-xs font-medium">Score 88.6</span>
            </div>
            <p class="text-white/50 text-xs">1040 S Miami Ave · T6-80 · $12.5M</p>
          </div>
        </div>
      </div>

      <div class="absolute" style="top: 25%; left: 55%;">
        <div class="relative">
          <div class="w-4 h-4 rounded-full bg-green-400 shadow-lg shadow-green-400/40 border-2 border-white/20" />
          <div class="absolute inset-0 rounded-full bg-green-400/20 animate-ping" style="animation-delay: 0.5s;" />
        </div>
      </div>

      <div class="absolute" style="top: 45%; left: 52%;">
        <div class="w-3.5 h-3.5 rounded-full bg-amber-400 shadow-lg shadow-amber-400/40 border border-white/20" />
      </div>

      <div class="absolute" style="top: 30%; left: 44%;">
        <div class="w-3 h-3 rounded-full bg-amber-400 border border-white/20" />
      </div>

      <div class="absolute" style="top: 55%; left: 50%;">
        <div class="w-2.5 h-2.5 rounded-full bg-gray-500 border border-white/20" />
      </div>

      <!-- Bottom legend -->
      <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between">
        <div class="glass rounded-xl px-4 py-3">
          <p class="text-xs text-white/40 mb-2 font-medium uppercase tracking-wider">Parcel tiers</p>
          <div class="flex items-center gap-4">
            {[
              { label: "Tier A", color: "bg-green-400", count: "12" },
              { label: "Tier B", color: "bg-amber-400", count: "58" },
              { label: "Tier C", color: "bg-gray-500", count: "177" },
            ].map((t) => (
              <div class="flex items-center gap-1.5">
                <div class={`w-2 h-2 rounded-full ${t.color}`} />
                <span class="text-xs text-white/60">{t.label}</span>
                <span class="text-xs text-white/30">({t.count})</span>
              </div>
            ))}
          </div>
        </div>

        <div class="glass rounded-xl px-4 py-3 text-right">
          <p class="text-xs text-white/30">Miami-Dade County</p>
          <p class="text-xs text-white/50 font-medium mt-0.5">Updated 2h ago</p>
        </div>
      </div>

      <!-- Top label -->
      <div class="absolute top-5 left-5">
        <div class="glass rounded-xl px-4 py-2.5 flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-blue-400 animate-pulse" />
          <span class="text-sm text-white/70 font-medium">Live parcel map</span>
        </div>
      </div>
    </div>
  </div>
</section>
