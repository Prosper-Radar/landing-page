---
const stats = [
  { value: "$2.8B", label: "Active pipeline" },
  { value: "247", label: "Parcels scored" },
  { value: "7", label: "Scoring criteria" },
  { value: "12", label: "Tier A deals live" },
  { value: "2", label: "Counties covered" },
  { value: "~5min", label: "Data refresh" },
];
---

<section class="relative border-y border-white/6 bg-[#0f1117]/60 backdrop-blur-sm overflow-hidden">
  <!-- Subtle grid bg -->
  <div class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 40px 40px;">
  </div>

  <div class="relative max-w-7xl mx-auto px-6 py-10">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 divide-x divide-white/6">
      {stats.map((s, i) => (
        <div class={`px-6 py-4 text-center ${i === 0 ? 'pl-0' : ''} ${i === stats.length - 1 ? 'pr-0' : ''}`}>
          <div class="text-2xl font-semibold text-white tabular-nums">{s.value}</div>
          <div class="text-xs text-white/35 mt-1 tracking-wide">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
